{% extends 'base.html.twig' %}

{% block intro %}
    <code class="font-mono text-sm text-heading">SweetAlert:ConfirmButton</code> and <code class="font-mono text-sm text-heading">SweetAlert:InputModal</code>
    hand the result either to a browser function or to a server-side Live action.
{% endblock %}

{% block content %}
    <section class="card grid gap-5 lg:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] lg:items-start">
        <div>
            <h2 class="font-display text-lg font-semibold text-heading">Browser callback</h2>
            <p class="mt-1 text-sm text-muted">The result goes to a JavaScript function.</p>
            <div class="mt-4 flex flex-wrap gap-2">
                {{ include('live/_callback.html.twig') }}
            </div>
            <output id="callback-output" class="mt-3 block font-mono text-xs break-all text-muted">No result yet</output>
        </div>
        <pre class="code"><code class="language-twig">{{ source('live/_callback.html.twig')|e }}</code></pre>
    </section>

    <section class="card">
        <h2 class="font-display text-lg font-semibold text-heading">Server-side Live action</h2>
        <p class="mt-1 text-sm text-muted">
            Delete extends <code class="font-mono text-heading">ConfirmButton</code> and overrides <code class="font-mono text-heading">callbackAction()</code>.
            Rename extends <code class="font-mono text-heading">InputModal</code> and overrides <code class="font-mono text-heading">onResult()</code>. The list lives in your session.
        </p>
        <div class="mt-4"><twig:TodoList/></div>
        <div class="mt-6 grid gap-4 xl:grid-cols-2">
            <pre class="code"><code class="language-php">{{ method_code('App\\Twig\\Components\\DeleteTodoButton::callbackAction') }}</code></pre>
            <pre class="code"><code class="language-php">{{ method_code('App\\Twig\\Components\\RenameTodoModal::onResult') }}</code></pre>
        </div>
        <pre class="code mt-4"><code class="language-twig">{{ source('components/TodoList.html.twig')|e }}</code></pre>
    </section>
{% endblock %}
