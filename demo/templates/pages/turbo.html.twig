{% extends 'base.html.twig' %}

{% block intro %}
    Turbo Drive is on for this whole demo: every "Try it" button is a form submission followed by a redirect.
    Below are the two responses Turbo can apply without a redirect.
{% endblock %}

{% block content %}
    <section class="card grid gap-5 lg:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] lg:items-start">
        <div>
            <h2 class="font-display text-lg font-semibold text-heading">Turbo Stream</h2>
            <form method="post" action="{{ path('turbo_stream') }}" data-turbo-stream class="mt-4">
                <button class="btn btn-primary">Save</button>
            </form>
            <p id="stream-saved-at" class="mt-3 text-sm text-muted">Not saved yet</p>
        </div>
        <pre class="code"><code class="language-php">{{ method_code('App\\Controller\\TurboController::turboStream') }}</code></pre>
    </section>

    <section class="card grid gap-5 lg:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] lg:items-start">
        <div>
            <h2 class="font-display text-lg font-semibold text-heading">Turbo Frame</h2>
            <div class="mt-4">{{ include('turbo/frame.html.twig') }}</div>
        </div>
        <pre class="code"><code class="language-php">{{ method_code('App\\Controller\\TurboController::turboFrame') }}</code></pre>
    </section>
{% endblock %}
